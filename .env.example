# Placeholder key required for Secrets Gradle Plugin BuildConfig generation.
# This placeholder is strictly rejected at runtime by AppPreferences.isPlaceholderKey().
# Configure your real key in AI Studio Secrets or in-app AI API Hub settings.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY1=YOUR_GEMINI_API_KEY1

# Google Maps Scraper Kit Configuration
# Local scraper service running via Docker (e.g. Mahanaicoach/google-maps-scraper-kit)
# Android emulator can reach host machine Docker service via http://10.0.2.2:8080
GOOGLE_MAPS_SCRAPER_URL=http://10.0.2.2:8080
GOOGLE_MAPS_SCRAPER_ENABLED=false

# Kavya OKF Agent Memory Configuration
KAVYA_MEMORY_ENABLED=true
